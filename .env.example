APP_NAME="WaveNxD AI Sales Representative"
APP_ENV="development"
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DATABASE="wavenxd_sales"

# LLM & Conversation Settings
LLM_PROVIDER="groq"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3"
OLLAMA_TIMEOUT_SECONDS=30.0
OLLAMA_MAX_TOKENS=1000

# Gemini Settings
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_TIMEOUT_SECONDS=30.0

# Groq Settings
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="qwen/qwen3.8-27b"
GROQ_TIMEOUT_SECONDS=30.0

# Fallback Settings (production-style quota-aware fallback)
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_PROVIDER="gemini"

# Conversation Limits
CONVERSATION_MAX_MESSAGES=100
MESSAGE_MAX_LENGTH=5000

# Voice Input (STT) Settings
STT_PROVIDER="groq"
GROQ_WHISPER_MODEL="whisper-large-v3"
STT_TIMEOUT_SECONDS=30.0
STT_MAX_FILE_SIZE_BYTES=26214400

# Voice Output (TTS) Settings
TTS_PROVIDER="gemini"
GEMINI_TTS_MODEL="gemini-3.8-flash-lite-tts"
GROQ_TTS_MODEL="playht-large"
TTS_TIMEOUT_SECONDS=30.0
TTS_MAX_CHARS=2000
